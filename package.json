{
  "name": "codex-remote-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "A small OpenSSH-backed MCP for inspected, staged and audited remote patches",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "bin": { "codex-remote-workbench": "src/server.js" },
